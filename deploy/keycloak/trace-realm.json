{
  "realm": "trace",
  "enabled": true,
  "displayName": "TRACE",
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "users": [
    {
      "username": "test",
      "enabled": true,
      "email": "test@example.test",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "trace-web",
      "name": "TRACE browser",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "${TRACE_WEB_ORIGIN}",
      "baseUrl": "${TRACE_WEB_ORIGIN}/",
      "redirectUris": ["${TRACE_WEB_ORIGIN}/*"],
      "webOrigins": ["${TRACE_WEB_ORIGIN}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${TRACE_WEB_ORIGIN}/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      },
      "defaultClientScopes": ["basic", "web-origins", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "trace-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "trace-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
