# Set real secrets locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BUSINESS_MCP_URL=http://localhost:8002/mcp
RAG_MCP_URL=http://localhost:8003/mcp
PHYSICS_MCP_URL=http://localhost:8004/mcp
SENSOR_MCP_URL=http://localhost:8005/mcp

# Must equal the access token's iss exactly. JWKS may use an internal hostname.
KEYCLOAK_ISSUER=http://localhost:18081/auth/realms/trace
# Alternative to KEYCLOAK_ISSUER, matching the existing service environment:
# KEYCLOAK_URL=http://localhost:18081/auth
KEYCLOAK_REALM=trace
KEYCLOAK_AUDIENCE=trace-api
KEYCLOAK_JWKS_URL=
INTERNAL_API_KEY=

# Optional tracing; not an OpenAI credential.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
