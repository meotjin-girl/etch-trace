# compose.yaml reads these values. Keep the old POC on its existing port.
WEB_PORT=18080
POSTGRES_PASSWORD=trace
INTERNAL_API_KEY=trace-local-development

# Development Keycloak administrator; create application users in /auth/admin/.
# Bootstrap settings only initialize a new keycloak_data volume.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=trace-dev-admin
# Compose derives these from WEB_PORT; override both together for another host.
# WEB_ORIGIN=http://localhost:18080
# KEYCLOAK_URL=http://localhost:18080/auth
# Browser client trace-web uses PKCE; backend audience is trace-api.
# New trace realms include the development app account test / test.
# See deploy/keycloak/README.md for existing-volume setup.

# Alert intake (docs/agent-request.md). Unset: backend polls the Compose
# prometheus service (http://prometheus:9090). Set empty to disable.
# PROMETHEUS_URL=

# Optional host-run service settings; compose.yaml supplies container URLs.
DATABASE_URL=postgresql://trace:trace@localhost:5432/trace
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001
# New standard Agent Server. Compose uses agent:2024 internally.
AGENT_SERVER_URL=http://localhost:2024
AGENT_SERVER_PORT=2024
BUSINESS_MCP_URL=http://localhost:8002/mcp
RAG_MCP_URL=http://localhost:8003/mcp
# Optional. Set to the MCP endpoint reachable from the Agent container.
PHYSICS_MCP_URL=http://localhost:8004/mcp
# Optional Mock Fab collector URL for the standalone Sensor MCP service.
# This does not connect Sensor MCP tools to the Agent Server.
FAB_COLLECTOR_URL=
# Compose does not publish DB/service ports; host runs need a separate test DB
# and explicitly started services. These localhost URLs do not expose ports.

# Optional LangSmith tracing. Compose forwards these to the agent only.
# Put your real key in the git-ignored root .env, never in this example file.
# Start with a personal project, e.g. etch-trace-developer-dev.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=etch-trace-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set when your key requires a specific workspace; otherwise leave empty.
LANGSMITH_WORKSPACE_ID=

# agent requires a real model for investigation experiments.
# This is separate from optional LangSmith tracing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional real-DB validation; use isolated test databases, never production.
# TEST_DATABASE_URL=postgresql:///postgres
# AGENT_TEST_DATABASE_URL=postgresql:///trace_test
# EVIDENCE_TEST_DATABASE_URL=postgresql:///trace_evidence_test
