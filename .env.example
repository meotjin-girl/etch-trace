# compose.yaml reads these values. Keep the old POC on its existing port.
WEB_PORT=18080
POSTGRES_PASSWORD=trace
INTERNAL_API_KEY=trace-local-development

# Optional host-run service settings; compose.yaml supplies container URLs.
DATABASE_URL=postgresql://trace:trace@localhost:5432/trace
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001
BUSINESS_MCP_URL=http://localhost:8002/mcp
RAG_MCP_URL=http://localhost:8003/mcp
# Compose does not publish DB/service ports; host runs need a separate test DB
# and explicitly started services. These localhost URLs do not expose ports.

# Optional LangSmith tracing. Compose forwards these to the agent only.
# Put your real key in the git-ignored root .env, never in this example file.
# Start with a personal project, e.g. etch-trace-developer-dev.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=etch-trace-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set when your key requires a specific workspace; otherwise leave empty.
LANGSMITH_WORKSPACE_ID=

# Optional constrained prose in agent/prose.py; not required for sample analysis.
# Compose now forwards both. This is separate from LangSmith tracing.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional shared RAG endpoint for the Agent (empty uses local rag-mcp).
SHARED_RAG_MCP_URL=
# Shared development Bearer token. Set the same value on the server and clients.
RAG_MCP_TOKEN=
# Dedicated remotely managed tunnel; used only with --profile rag-share.
# Route mcp-etch-trace-rag.dayeondev.com /mcp to http://rag-mcp:8000.
CF_RAG_TUNNEL_TOKEN=

# Optional real-DB validation; use isolated test databases, never production.
# TEST_DATABASE_URL=postgresql:///postgres
# AGENT_TEST_DATABASE_URL=postgresql:///trace_test
# EVIDENCE_TEST_DATABASE_URL=postgresql:///trace_evidence_test
